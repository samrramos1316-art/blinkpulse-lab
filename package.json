{
  "name": "blinkpulse-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "predev": "node tools/copy-mediapipe-assets.mjs",
    "dev": "vite",
    "predev:phone": "node tools/copy-mediapipe-assets.mjs && node tools/make-dev-cert.mjs",
    "dev:phone": "vite --mode phone",
    "prebuild": "node tools/copy-mediapipe-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "score:v1": "node tools/score_v1.ts",
    "eval": "node tools/eval_cli.ts",
    "bench:pulse": "node tools/bench_pulse.ts",
    "ppg:ref": "node tools/ppg_to_ref.ts",
    "hrv:limits": "node tools/hrv_limits.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
